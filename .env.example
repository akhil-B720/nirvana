# =============================================
# NIRVANA — Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to version control
# =============================================

# ----- DATABASE -----
# SQLite (default for development)
DATABASE_URL=sqlite+aiosqlite:///./nirvana.db

# PostgreSQL (production — uncomment and fill in)
# DATABASE_URL=postgresql+psycopg2://nirvana_user:your_password@localhost:5432/nirvana_db

# ----- SECURITY -----
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- OPENAI -----
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL=gpt-4o-mini

# ----- ML -----
MODEL_PATH=./models
DATA_PATH=./dataset

# ----- MAP -----
# MapLibre GL JS is free and open-source — no token needed
# If you want to use MapTiler or Mapbox as a tile source, add a token:
MAPTILER_KEY=optional-for-premium-tiles

# ----- DATA SOURCES -----
DATA_GOV_IN_API_KEY=optional-for-higher-rate-limits

# ----- APP -----
APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=10

# ----- CORS -----
FRONTEND_URL=http://localhost:5173

# ----- ADMIN -----
# Default admin credentials (change immediately after first login)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@nirvana.gov.in
INITIAL_ADMIN_PASSWORD=ChangeMe@2024!
